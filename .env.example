# -----------------------------------------------------------------------------
# Vantis — Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# Production secrets must NEVER be committed to version control.
# Generate cryptographically secure values for JWT_SECRET, ENCRYPTION_KEY,
# and AI_SERVICE_TOKEN in your deployment environment.
# -----------------------------------------------------------------------------

# Application
APP_NAME=Vantis
APP_ENV=production
DEBUG=false

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=prod

# Database (PostgreSQL 16 + pgvector)
# In production, database connections require TLS encryption (sslmode=require minimum).
# For cloud providers requiring CA certificate verification (e.g. AWS RDS, GCP Cloud SQL):
#   Set sslmode=verify-full and provide the CA bundle via sslrootcert, e.g.:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.example.internal:5432/flowops?sslmode=verify-full&sslrootcert=/etc/ssl/certs/db-ca.pem
POSTGRES_USER=flowops
POSTGRES_PASSWORD=<configure-in-deployment-environment>
POSTGRES_DB=flowops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=require
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/flowops?sslmode=require
SPRING_DATASOURCE_USERNAME=flowops
SPRING_DATASOURCE_PASSWORD=<configure-in-deployment-environment>

# Redis (Distributed Rate Limiting & Execution Coordination)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
# Generate with: openssl rand -base64 48 (min 32 bytes / 256 bits)
JWT_SECRET=<generate-in-deployment-environment>
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=None

# OAuth2 Provider Credentials (Server-side only — configure in Google Cloud / GitHub Developer Settings)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Symmetric Encryption for Integration Credentials at Rest (AES-256-GCM)
# Generate with: openssl rand -base64 32 (must decode to exactly 32 bytes)
ENCRYPTION_KEY=<generate-in-deployment-environment>

# Service-to-Service AI Token (Shared between Backend and AI Service)
# Generate with: openssl rand -hex 32
AI_SERVICE_TOKEN=<generate-shared-service-token>
AI_SERVICE_URL=http://ai-service:8100

# AI Provider Credentials (Kept exclusively in AI Service)
AI_PROVIDER=omniroute
OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1
OMNIROUTE_MODEL=auto/best-chat
OMNIROUTE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Operator SMTP Relay (Password reset mailer)
SMTP_HOST=<configure-in-deployment-environment>
SMTP_PORT=587
SMTP_USERNAME=<configure-in-deployment-environment>
SMTP_PASSWORD=<configure-in-deployment-environment>
SMTP_ENCRYPTION=STARTTLS
SMTP_FROM_ADDRESS=<configure-in-deployment-environment>
SMTP_FROM_NAME=Vantis
FRONTEND_PUBLIC_URL=http://localhost:3000

# Frontend Configuration (Browser-accessible, no secrets)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=Vantis

# Billing & Pricing Configuration
# Set PRIVATE_BETA=true and BILLING_ENABLED=false during preview.
# To activate live billing: set PRIVATE_BETA=false and BILLING_ENABLED=true.
PRIVATE_BETA=true
BILLING_ENABLED=false
ENTITLEMENTS_ENFORCEMENT=log
DEFAULT_CURRENCY=USD
DEFAULT_COUNTRY=US
