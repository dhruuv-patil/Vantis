# -----------------------------------------------------------------------------
# Vantis — Backend Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to backend/.env for local standalone backend development:
#   cp backend/.env.example backend/.env
# -----------------------------------------------------------------------------

# Authentication & JWT Signing Secret (>= 32 bytes)
# Generate with: openssl rand -base64 48
JWT_SECRET=<generate-in-deployment-environment>

# Symmetric AES-256-GCM Encryption Key (Base64-encoded 32 bytes)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=<generate-in-deployment-environment>

# Shared Service Token presented to AI service via X-Service-Token
# Generate with: openssl rand -hex 32
AI_SERVICE_TOKEN=<generate-shared-service-token>
AI_SERVICE_URL=http://localhost:8100

# Database Configuration
# Local dev runs without TLS. In production (SPRING_PROFILES_ACTIVE=prod), TLS is required:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/flowops?sslmode=require
#   POSTGRES_SSL_MODE=require
# For verify-full with CA bundle:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.example.internal:5432/flowops?sslmode=verify-full&sslrootcert=/etc/ssl/certs/db-ca.pem
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/flowops
POSTGRES_SSL_MODE=require
SPRING_DATASOURCE_USERNAME=flowops
SPRING_DATASOURCE_PASSWORD=<configure-in-deployment-environment>

# Redis (Distributed Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS & Server
BACKEND_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=http://localhost:8080

# Password Reset SMTP Relay
SMTP_HOST=<configure-in-deployment-environment>
SMTP_PORT=587
SMTP_USERNAME=<configure-in-deployment-environment>
SMTP_PASSWORD=<configure-in-deployment-environment>
SMTP_ENCRYPTION=STARTTLS
SMTP_FROM_ADDRESS=<configure-in-deployment-environment>
SMTP_FROM_NAME=Vantis
FRONTEND_PUBLIC_URL=http://localhost:3000

# Billing & Entitlements
ENTITLEMENTS_ENFORCEMENT=log
PRIVATE_BETA=true
BILLING_ENABLED=false
BILLING_PROVIDER=noop
# STRIPE_SECRET_KEY=<configure-in-deployment-environment>
# STRIPE_WEBHOOK_SECRET=<configure-in-deployment-environment>
# RAZORPAY_KEY_ID=<configure-in-deployment-environment>
# RAZORPAY_KEY_SECRET=<configure-in-deployment-environment>
# RAZORPAY_WEBHOOK_SECRET=<configure-in-deployment-environment>
