# -----------------------------------------------------------------------------
# Vantis — AI Service Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to ai-service/.env for local standalone AI service development:
#   cp ai-service/.env.example ai-service/.env
# -----------------------------------------------------------------------------

# Shared Service Token validated on all /ai/* routes via X-Service-Token
# Must match the AI_SERVICE_TOKEN configured in the backend
# Generate with: openssl rand -hex 32
AI_SERVICE_TOKEN=<generate-shared-service-token>

# Active AI provider ("omniroute" or "gemini")
AI_PROVIDER=omniroute

# OmniRoute (Bring-your-own-key)
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1
OMNIROUTE_MODEL=auto/best-chat

# Google Gemini API Key (Bring-your-own-key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Allowed callers (Backend origin)
CORS_ORIGINS=http://localhost:8080
